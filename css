body{
   font-family: Arial, sans-serif;
   background: linear-gradient(#0d3b2a,#145a32);
   text-align:center;
   color:white;
}

.passo{
   display:none;
}

.passo.ativo{
   display:block;
}

#capa{
   margin-top:50px;
}

#capa img{
   width:300px;
   border-radius:20px;
}

h1{
   font-size:40px;
   margin-top:20px;
}

p{
   font-size:20px;
   max-width:600px;
   margin:auto;
}

button{
   background:#ffd700;
   color:black;
   border:none;
   padding:15px 30px;
   font-size:20px;
   border-radius:12px;
   margin-top:20px;
   cursor:pointer;
}

button:hover{
   transform:scale(1.05);
}
